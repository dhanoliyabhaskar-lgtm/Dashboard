doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Notifications
  link(rel='stylesheet' href='/static/notifications.css')
body(data-theme=user.theme)
.container
  header
    button(onclick="window.location.href='/dashboard'")
      img#darkicon(src='/static/photos/back.png' alt='')
      img#lighticon(src='/static/photos/back icon light.png' alt='')
    .right
      h1 Notifications
      p Here&apos;s What&apos;s Happening 
  main
    - const notifications = user && user.notification ? user.notification : []
    #goalsreminder.box
      .heading
        img(src='/static/photos/notifications reminder icon.png' alt='')
        h2 Goals Reminders
      .content
        each notification in notifications
          if notification.type=='reminder'
            .item
              .left
                span #{notification.topic}
                p #{notification.name}
              .right
                div #{notification.date}
                span 
                  b &bull;
    #websiteupdates.box
      .heading
        img(src='/static/photos/notifications updates icon.png' alt='')
        h2 Website Updates
      .content
        each notification in notifications
          if notification.type=='updates'
            .item
              .left
                span #{notification.topic}
                p #{notification.name}
              .right
                div #{notification.date}
                span 
                  b &bull;
    #weeklysummary.box
      .heading
        img(src='/static/photos/notifications summary icon.png' alt='')
        h2 Weekly Summary Report
      .content
        each notification in notifications
          if notification.type=='report'
            .item
              .left
                span #{notification.topic}
                p #{notification.name}
              .right
                div #{notification.date}
                span 
                  b &bull;
script(src="/static/notifications.js") 