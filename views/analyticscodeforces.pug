doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Analytics
  link(rel='stylesheet' href='/static/analyticscodeforces.css')
body(data-user=user)
.container
  aside.sidebar
    .logo
      img(src='/static/photos/dashboard logo.png' alt='')
      h2 Dashboard
    ul.menu
      li
        a(href='/dashboard')
          img(src='/static/photos/overview icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/overview white icon.png' alt='' class="white-sidebar-icon")
          span  Overview 
      li.active
        a(href='/analyticsgithub')
          img(src='/static/photos/analytics icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/analytics white icon.png' alt='' class="white-sidebar-icon")
          span Analytics
      li
        a(href='/goals')
          img(src='/static/photos/goals icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/goals white icon.png' alt='' class="white-sidebar-icon")
          span Goals
      li
        a(href='/integration')
          img(src='/static/photos/integrations icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/integrations white icon.png' alt='' class="white-sidebar-icon")
          span Integrations
      li
        a(href='/reports')
          img(src='/static/photos/reports icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/reports white icon.png' alt='' class="white-sidebar-icon")
          span Reports
      li
        a(href='/achievements')
          img(src='/static/photos/achievements icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/achievements white icon.png' alt='' class="white-sidebar-icon")
          span Achievements
      li
        a(href='/settingsprofile')
          img(src='/static/photos/settings icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/settings white icon.png' alt='' class="white-sidebar-icon")
          span Settings
  .main-content
    // responsive header
    header.responsive-header
      .header-left
        button.menu-btn(onclick='roggle()')  &#x2630; 
        h2 Dashboard
      .header-right
        .notification-wrapper
            button(onclick='window.location.href="/notifications"')
              img.notifications-icon(src='/static/photos/notifications icon.jpeg' alt='notification')            
            span.badge 3
        button(onclick='window.location.href="/settingsprofile"')
          img.profile-logo(src='/static/photos/profile logo.png' alt='profile photo')
    .content(onclick='moggle()')
      // Header
      header.analytics-header
        div
          h2 Analytics
          p  Deep dive into your productivity 
      .tabs
        button(onclick="window.location.href='/analyticsgithub'") Github
        button(onclick="window.location.href='/analyticscodeforces'"  class="active") Codeforeces
        button(onclick="window.location.href='/analyticsspotify'") Spotify
        button(onclick="window.location.href='/analyticscalender'") Calendar
      section.analytics-cards
        .card
          .left &#x2B50;
          .right
            h4 Current Rating
            div
              b #{user.codeforces.currentrating}
        .card
          .left &#x1F525;
          .right
            h4 Max Rank
            div
              b #{user.codeforces.maxrank}
        .card
          .left &#x2708;&#xFE0F;
          .right
            h4 Problem Solved
            div
              b #{user.codeforces.problemsolved}
        .card
          .left &#x1F465;
          .right
            h4 Friends
            div
              b #{user.codeforces.followcount}
      section.top-widgets
        #box-1.box
        #box-2.box
        #box-3.box
      .bottom-widgets
        .filter
          p.scroll-hint &larr; Swipe horizontally to view all &rarr;
          h4 Wrong Answers Filter
          .wrong-answers
            - const rawWrong = user && user.codeforces && user.codeforces.wronganswers
            - const wrongarr = Array.isArray(rawWrong) ? rawWrong : (rawWrong ? Object.values(rawWrong) : [])

            if wrongarr && wrongarr.length > 0
              each wrong in wrongarr
                .wrong
                  .left
                    b &bull;
                    .name #{wrong.name}
                  .right
                    .language #{wrong.language} | 
                    .verdict #{wrong.type}
                    .time | #{wrong.duration} ms
        .table
          p.scroll-hint &larr; Swipe horizontally to view all columns &rarr;
          h4 Recent Submissions Table
          table
            thead
              tr
                th Problem Name
                th Language
                th Verdict
                th Time(ms)
                th Memory(MB)
            tbody
              - const raw = user && user.codeforces && user.codeforces.content
              - const questionarr = Array.isArray(raw) ? raw : (raw ? Object.values(raw) : [])

              if questionarr.length>0
                each question in questionarr.slice(0,5)
                  tr 
                    td #{question.name}
                    td #{question.language}
                    td #{question.type}
                    td #{question.duration || 0} ms
                    td #{question.memory || 0} KB
script(src='https://cdn.jsdelivr.net/npm/apexcharts')
script(src='/static/analyticscodeforces.js')
