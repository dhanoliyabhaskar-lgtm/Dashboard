doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Analytics
  link(rel='stylesheet' href='/static/analyticsspotify.css')
body(data-user=user)
.container
  aside.sidebar
    .logo
      img(src='/static/photos/dashboard logo.png' alt='')
      h2 Dashboard
    ul.menu
      li
        a(href='/dashboard')
          img(src='/static/photos/overview icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/overview white icon.png' alt='' class="white-sidebar-icon")
          span  Overview 
      li.active
        a(href='/analyticsgithub')
          img(src='/static/photos/analytics icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/analytics white icon.png' alt='' class="white-sidebar-icon")
          span Analytics
      li
        a(href='/goals')
          img(src='/static/photos/goals icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/goals white icon.png' alt='' class="white-sidebar-icon")
          span Goals
      li
        a(href='/integration')
          img(src='/static/photos/integrations icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/integrations white icon.png' alt='' class="white-sidebar-icon")
          span Integrations
      li
        a(href='/reports')
          img(src='/static/photos/reports icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/reports white icon.png' alt='' class="white-sidebar-icon")
          span Reports
      li
        a(href='/achievements')
          img(src='/static/photos/achievements icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/achievements white icon.png' alt='' class="white-sidebar-icon")
          span Achievements
      li
        a(href='/settingsprofile')
          img(src='/static/photos/settings icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/settings white icon.png' alt='' class="white-sidebar-icon")
          span Settings
  .main-content
    // responsive header
    header.responsive-header
      .header-left
        button.menu-btn(onclick='roggle()')  &#x2630; 
        h2 Dashboard
      .header-right
        .notification-wrapper
            button(onclick='window.location.href="/notifications"')
              img.notifications-icon(src='/static/photos/notifications icon.jpeg' alt='notification')            
            span.badge 3
        button(onclick='window.location.href="/settingsprofile"')
          img.profile-logo(src='/static/photos/profile logo.png' alt='profile photo')
    .content(onclick='moggle()')
      // Header
      header.analytics-header
        div
          h2 Analytics
          p  Deep dive into your productivity 
      .tabs
        button(onclick="window.location.href='/analyticsgithub'") Github
        button(onclick="window.location.href='/analyticscodeforces'") Codeforeces
        button(onclick="window.location.href='/analyticsspotify'"  class="active") Spotify
        button(onclick="window.location.href='/analyticscalender'") Calendar
      - const totallisteningtime = user && user.totallisteningtime ? user.totallisteningtime : []
      - const songplayed = user && user.songplayed ? user.songplayed : []
      - const newartist = user && user.newartist ? user.newartist : []
      - const recentlyplayedtime = user && user.recentlyplayedtime ? user.recentlyplayedtime : []
      - const recentlyplayed = user && user.recentlyplayed ? user.recentlyplayed : []
      - const topartist = user && user.topartist ? user.topartist : []
      - const toptrack = user && user.toptrack ? user.toptrack : []
      - const topplaylist = user && user.topplaylist ? user.topplaylist : []
      section.analytics-cards
        .card
          .left &#x1F3B5;
          .right
            h4 Total Listening Time
            if totallisteningtime.length>0
              div
                b #{totallisteningtime[0]} h
              - const diff = totallisteningtime[0] - totallisteningtimeforweek[0]
              if diff > 0
                span.text-success &uarr; #{diff.toFixed(1)}% vs last week
              else if diff<0
                span.text-danger &darr; #{Math.abs(diff).toFixed(1)}% vs last week
              else if diff==0
                span.text-normal -- 
        .card
          .left &#x1F3B5;
          .right
            h4 Songs Played
            if songplayed.length>0
              div
                b #{songplayed[0]} h
              - const diff1 = songplayed[0] - songplayed[7]
              if diff1 > 0
                span.text-success &uarr; #{diff1.toFixed(1)}% vs last week
              else if diff1<0
                span.text-danger &darr; #{Math.abs(diff1).toFixed(1)}% vs last week
              else if diff1==0
                span.text-normal --
        .card
          .left &#x1F3B5;
          .right
            h4 Unique Artists
            if newartist.length>0
              div
                b #{newartist[0]} h
              - const diff3 = newartist[0] - newartist[7]
              if diff3 > 0
                span.text-success &uarr; #{diff3.toFixed(1)}% vs last week
              else if diff3<0
                span.text-danger &darr; #{Math.abs(diff3).toFixed(1)}% vs last week
              else if diff3==0
                span.text-normal -- 
        .card
          .left &#x1F3B5;
          .right
            h4 Avg. Track Duration
            if recentlyplayedtime.length>0
              div
                b #{recentlyplayedtime[0]} h
              - const diff4 = recentlyplayedtime[0] - recentlyplayedtime[7]
              if diff > 0
                span.text-success &uarr; #{diff4.toFixed(1)}% vs last week
              else if diff4<0
                span.text-danger &darr; #{Math.abs(diff4).toFixed(1)}% vs last week
              else if diff4==0
                span.text-normal --
      section.top-widgets
        #chart1
        #recentsongs.widget
          p.scroll-hint &larr; Swipe horizontally to view all &rarr;
          .header
            h4  Recently Played 
          table.recentsongs
            thead
              tr
                th Songs
                th Last Played
            tbody
              //tr
              //  td.recent
              //    img(src='/static/photos/1st rank icon.jpg' alt='')
              //    span  Shape of You anvnadjklvkadgbjka 
              //  td 3 min ago
              if recentlyplayed.length>0
                each song in recentlyplayed
                  tr 
                    td.recent 
                      img(src=`${song.icon}`)
                      span #{song.song}
                    td #{song.time}
        #artists.widget
          p.scroll-hint &larr; Swipe horizontally to view all &rarr;
          .header
            h4  Top Artists 
          table.artists
            thead
              tr
                th #
                th Artists
                th Worldwide Popularity
            tbody
              if topartist.length>0
                - let count = 1
                each artist in topartist
                  tr 
                    td #{count}
                    td.singer 
                      image(src=`${artist.logo}`)
                      span #{artist.name}
                    td #{artist.popularity}/100
                    - count++
      section.bottom-widgets
        #tracks.widget
          p.scroll-hint &larr; Swipe horizontally to view all &rarr;
          .header
            h4  Top Tracks 
          table.tracks
            thead
              tr
                th #
                th Track
                th Artists
            tbody
              if toptrack.length>0
                - let count = 1
                each track in toptrack
                  tr
                    td #{count}
                    td.song 
                      img(src=`${track.logo}`)
                      span #{track.name}
                    td #{track.artist}
                  - count++
        #playlists.widget
          p.scroll-hint &larr; Swipe horizontally to view all &rarr;
          .header
            h4  Top Playlists 
          table.playlists
            thead
              tr
                th #
                th Playlists
                th No. of Songs
            tbody
              if topplaylist.length>0
                - let count = 1
                each playlist in topplaylist
                  tr
                    td #{count}
                    td.playlist 
                      img(src=`${playlist.logo}`)
                      span #{playlist.name}
                    td #{playlist.track}
                    - count++
        #insights.widget
          h4  Insights 
          .items
            .left &#x1F3B5;
            .right
              if topartist.length>0
                p
                  b #{topartist[0].name}
                  |  is your top Artist.
                p You are listening to Arijit Singh the most.
          .items
            .left &#x2B50;
            .right
              if toptrack.length>0
                p
                  b #{toptrack[0].name}
                  |  is your top track.
                p You listened this track most this week.
          .items
            .left &#x1F525;
            .right
              if topplaylist.length>0
                p
                  b #{topplaylist.name}
                  |  tops your playlist rankings.
                p It&apos;s your most-played playlist this week. 
script(src='https://cdn.jsdelivr.net/npm/apexcharts')
script(src='/static/analyticsspotify.js')
