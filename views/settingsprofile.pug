doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Settings
  link(rel='stylesheet' href='/static/settingsprofile.css')
body(data-theme=user.theme)
.container
  // Sidebar
  aside.sidebar
    .logo
      img(src='/static/photos/dashboard logo.png' alt='')
      h2 Dashboard
    ul.menu
      li
        a(href='/dashboard')
          img(src='/static/photos/overview icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/overview white icon.png' alt='' class="white-sidebar-icon")
          span  Overview 
      li
        a(href='/analyticsgithub')
          img(src='/static/photos/analytics icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/analytics white icon.png' alt='' class="white-sidebar-icon")
          span Analytics
      li
        a(href='/goals')
          img(src='/static/photos/goals icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/goals white icon.png' alt='' class="white-sidebar-icon")
          span Goals
      li
        a(href='/integration')
          img(src='/static/photos/integrations icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/integrations white icon.png' alt='' class="white-sidebar-icon")
          span Integrations
      li
        a(href='/reports')
          img(src='/static/photos/reports icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/reports white icon.png' alt='' class="white-sidebar-icon")
          span Reports
      li
        a(href='/achievements')
          img(src='/static/photos/achievements icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/achievements white icon.png' alt='' class="white-sidebar-icon")
          span Achievements
      li.active
        a(href='/settingsprofile')
          img(src='/static/photos/settings icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/settings white icon.png' alt='' class="white-sidebar-icon")
          span Settings
  // Main Content
  .main-content
    // responsive header
    header.responsive-header
      .header-left
        button.menu-btn(onclick='roggle()')  &#x2630; 
        h2 Dashboard
      .header-right
        .notification-wrapper
            button(onclick='window.location.href="/notifications"')
              img.notifications-icon(src='/static/photos/notifications icon.jpeg' alt='notification')            
            span.badge 3
        button(onclick='window.location.href="/settingsprofile"')
          img.profile-logo(src='/static/photos/profile logo.png' alt='profile photo')
    .content(onclick='moggle()')
      // header
      header.settings-header
        div
          h2  Settings 
          p  Manage your account preferences and application settings. 
      .settings-page
        .settings-bar
          button.active(onclick="window.location.href='/settingsprofile' ")
            img(src='/static/photos/settings profile icon.png' alt='')
            span Profile
          button(onclick="window.location.href='/settingsnotifications' ")
            img(src='/static/photos/settings notifications icon.png' alt='')
            span Notifications
          button(onclick="window.location.href='/settingstheme' ")
            img(src='/static/photos/settings themes icon.png' alt='' style='size: 0.8em')
            span Themes
          button(onclick="window.location.href='/settingsprivacy' ")
            img(src='/static/photos/settings privacy&security icon.png' alt='')
            span Privacy &amp; Security
          button(onclick="window.location.href='/settingshelp' ")
            img(src='/static/photos/settings help&feedback icon.png' alt='')
            span Help &amp; Feedback
          button(onclick="window.location.href='/settingslogout' ")
            img(src='/static/photos/settings logout icon.png' alt='')
            span Log Out
        .profile-page
          .profile-heading
            h3 Profile Information
            .profile-pic
              img(src='/static/photos/profile logo.png' alt='profile pic')
          .profile-info
            .profile-pic
              img(src='/static/photos/profile logo.png' alt='profile pic')
            .personal-info
              form(action="/settingsprofile" method="post")
                  div
                    | Name: 
                    br
                    p.box #{user.name}
                  div
                    | Email: 
                    br
                    p.box #{user.email}
                  div
                    | Age: 
                    br
                    p.box 21
script(src='/static/settingsprofile.js')
