doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Report
  link(rel='stylesheet' href='/static/reports.css')
body(data-theme=user.theme)
.container
  // Sidebar
  aside.sidebar
    .logo
      img(src='/static/photos/dashboard logo.png' alt='')
      h2 Dashboard
    ul.menu
      li
        a(href='/dashboard')
          img(src='/static/photos/overview icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/overview white icon.png' alt='' class="white-sidebar-icon")
          span  Overview 
      li
        a(href='/analyticsgithub')
          img(src='/static/photos/analytics icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/analytics white icon.png' alt='' class="white-sidebar-icon")
          span Analytics
      li
        a(href='/goals')
          img(src='/static/photos/goals icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/goals white icon.png' alt='' class="white-sidebar-icon")
          span Goals
      li
        a(href='/integration')
          img(src='/static/photos/integrations icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/integrations white icon.png' alt='' class="white-sidebar-icon")
          span Integrations
      li.active
        a(href='/reports')
          img(src='/static/photos/reports icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/reports white icon.png' alt='' class="white-sidebar-icon")
          span Reports
      li
        a(href='/achievements')
          img(src='/static/photos/achievements icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/achievements white icon.png' alt='' class="white-sidebar-icon")
          span Achievements
      li
        a(href='/settingsprofile')
          img(src='/static/photos/settings icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/settings white icon.png' alt='' class="white-sidebar-icon")
          span Settings
  .main-content
    // responsive header
    header.responsive-header
      .header-left
        button.menu-btn(onclick='roggle()')  &#x2630; 
        h2 Dashboard
      .header-right
        .notification-wrapper
            button(onclick='window.location.href="/notifications"')
              img.notifications-icon(src='/static/photos/notifications icon.jpeg' alt='notification')            
            span.badge 3
        button(onclick='window.location.href="/settingsprofile"')
          img.profile-logo(src='/static/photos/profile logo.png' alt='profile photo')
    .content(onclick='moggle()')
      // header
      header.reports-header
        div
          h2  Reports 
          p  Generate and download your productivity reports. 
      // Filters
      form(action='/reports' method='post')
        .filter-group
          .filter
            label Report Type:
            select(name='type')
              option(value='weekly') Weekly
              option(value='monthly') Monthly
              option(value='custom') Custom
          .filter
            label Select Starting Date:
            input(type='date' name='when' required=true)
        button.generate-btn(type='submit') Generate Report
      // Available Reports
      .reports-card
        h3 Available Reports In PDF Format
        // Report Item
        .report-item
          .report-icon
            | &#x1F4C4;
          div
            h4 Weekly Summary Report
            p Overview of your weekly productivity.
        .report-item
          .report-icon
            | &#x1F4CA;
          div
            h4 Monthly Analysis Report
            p Detailed monthly analysis and trends.
        .report-item
          .report-icon
            | &#x1F4C1;
          div
            h4 Custom Report
            p Overview of any specific date productivity.
script(src='/static/reports.js')
