doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Integration
  link(rel='stylesheet' href='/static/integrations.css')
body(data-user=user)
  .container
    // Sidebar
    aside.sidebar
      .logo
        img(src='/static/photos/dashboard logo.png' alt='')
        h2 Dashboard
      ul.menu
        li
          a(href='/dashboard')
            img(src='/static/photos/overview icon.png' alt='' class="black-sidebar-icon")
            img(src='/static/photos/overview white icon.png' alt='' class="white-sidebar-icon")
            span  Overview 
        li
          a(href='/analyticsgithub')
            img(src='/static/photos/analytics icon.png' alt='' class="black-sidebar-icon")
            img(src='/static/photos/analytics white icon.png' alt='' class="white-sidebar-icon")
            span Analytics
        li
          a(href='/goals')
            img(src='/static/photos/goals icon.png' alt='' class="black-sidebar-icon")
            img(src='/static/photos/goals white icon.png' alt='' class="white-sidebar-icon")
            span Goals
        li.active
          a(href='/integration')
            img(src='/static/photos/integrations icon.png' alt='' class="black-sidebar-icon")
            img(src='/static/photos/integrations white icon.png' alt='' class="white-sidebar-icon")
            span Integrations
        li
          a(href='/reports')
            img(src='/static/photos/reports icon.png' alt='' class="black-sidebar-icon")
            img(src='/static/photos/reports white icon.png' alt='' class="white-sidebar-icon")
            span Reports
        li
          a(href='/achievements')
            img(src='/static/photos/achievements icon.png' alt='' class="black-sidebar-icon")
            img(src='/static/photos/achievements white icon.png' alt='' class="white-sidebar-icon")
            span Achievements
        li
          a(href='/settingsprofile')
            img(src='/static/photos/settings icon.png' alt='' class="black-sidebar-icon")
            img(src='/static/photos/settings white icon.png' alt='' class="white-sidebar-icon")
            span Settings
    .main-content
      // responsive header
      header.responsive-header
        .header-left
          button.menu-btn(onclick='roggle()')  &#x2630; 
          h2 Dashboard
        .header-right
          .notification-wrapper
            button(onclick='window.location.href="/notifications"')
              img.notifications-icon(src='/static/photos/notifications icon.jpeg' alt='notification')            
              span.badge 3
          button(onclick='window.location.href="/settingsprofile"')
            img.profile-logo(src='/static/photos/profile logo.png' alt='profile photo')
      .content(onclick='moggle()')
        // header
        header.integrations-header
          div
            h2 Integrations
            p Connect your favorite platforms and sync your data.
        .integrations-card
          // Third Party Apps
          h3 Third Party Apps
          .integrations-item
            .left
              .icon &#x1F4C5;
              span Google Calendar
            .status-box
              button.connect-btn#googlecalendarbtn(onclick="window.location.href='/auth/calender'") Connect 
              span#googlecalendarstatus.status-connected  Connected 
            .right
              button.sync &#x1F5D8;
          .integrations-item
            .left
              .icon &#x1F3B5;
              span Spotify
            .status-box
              button.connect-btn#spotifybtn(onclick="window.location.href='/auth/spotify'") Connect
              span#spotifystatus.status-connected  Connected 
            .right
              button.sync &#x1F5D8;
          .integrations-item
            .left
              .icon &#x1F431;
              span GitHub
            .status-box
              button.connect-btn#githubbtn(onclick="window.location.href='/auth/github'") Connect 
              span#githubstatus.status-connected  Connected 
            .right
              button.sync &#x1F5D8;
          .integrations-item
            .left
              .icon &#x1F431;
              span CodeForces
            .status-box
              button.connect-btn#codeforcesbtn(onclick="window.location.href='/codeforceslogin'") Connect 
              span.status-connected#codeforcesstatus Connected 
            .right
              button.sync &#x1F5D8;
  script(src='/static/integrations.js')
