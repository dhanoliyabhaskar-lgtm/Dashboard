doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Home
  link(rel='stylesheet' href='/static/dashboard.css')
body(data-user=user)
.container
  // Sidebar
  aside.sidebar
    .logo
      img(src='/static/photos/dashboard logo.png' alt='')
      h2 Dashboard
    ul.menu
      li.active
        a(href='/dashboard')
          img(src='/static/photos/overview icon.png' alt='')
          span  Overview 
      li
        a(href='/analyticsgithub')
          img(src='/static/photos/analytics icon.png' alt='')
          span Analytics
      li
        a(href='/goals')
          img(src='/static/photos/goals icon.png' alt='')
          span Goals
      li
        a(href='/integration')
          img(src='/static/photos/integrations icon.png' alt='')
          span Integrations
      li
        a(href='/reports')
          img(src='/static/photos/reports icon.png' alt='')
          span Reports
      li
        a(href='/achievements')
          img(src='/static/photos/achievements icon.png' alt='')
          span Achievements
      li
        a(href='/settingsprofile')
          img(src='/static/photos/settings icon.png' alt='')
          span Settings
  // Main Content
  main.main-content
    // responsive header
    header.responsive-header
      .header-left
        button.menu-btn(onclick='roggle()')  &#x2630; 
        h2 Dashboard
      .header-right
        .notification-wrapper
          button(onclick='window.location.href="/notifications"')
            img.notifications-icon(src='/static/photos/notifications icon.jpeg' alt='notification')          
          span.badge #{user.totalnotification}
        button(onclick='window.location.href="/settingsprofile"')
          img.profile-logo(src='/static/photos/profile logo.png' alt='profile photo')
    .content(onclick='moggle()')
      // Header
      header.overview-header
        .header-left
          h2 Hi,  #{user.name} &#x1F44B;
          p Here&apos;s your productivity overview.
        .header-right
            .notification-wrapper
                button(onclick='window.location.href="/notifications"')
                  img.notifications-icon(src='/static/photos/notifications icon.jpeg' alt='notification')            
                  span.badge #{user.totalnotification}
            button(onclick='window.location.href="/settingsprofile"')
              img.profile-logo(src='/static/photos/profile logo.png' alt='profile photo')
      section.stats-cards
        .card
          h3 GitHub
          p Commits this week
          - let week1 = user.github.thisweekcommit
          - let week2 = user.github.lastweekcommit
          - let diff = week1 !== 0 ? (((week1-week2)/week1)*100) : 0
          .number #{week1}
          if diff > 0
            span.text-success &uarr; #{diff.toFixed(1)}% vs last week
          else if diff<0
            span.text-danger &darr; #{Math.abs(diff).toFixed(1)}% vs last week
          else if diff==0
            span.text-normal --
        .card
          h3 Codeforces
          p Problems Solved this week
          - week1 = user.codeforces.problemsolvedthisweek
          - week2 = user.codeforces.problemsolvedlastweek
          - diff = week1 !== 0 ? (((week1-week2)/week1)*100) : 0
          .number #{week1}
          if diff > 0
            span.text-success &uarr; #{diff.toFixed(1)}% vs last week
          else if diff<0
            span.text-danger &darr; #{Math.abs(diff).toFixed(1)}% vs last week
          else if diff==0
            span.text-normal --
        .card
          h3 Spotify
          p Listening Time
          .number 12.4 hrs
          span.text-success &uarr; 8% vs last week
        .card
          h3 Calendar
          p Events this week
          - week1 = user.calender.totaleventsforweek || 0
          - const lastweek1 = user.calender.totaleventsforlastweek || 0
          - const diff1 = week1 !== 0 ? (((week1 - lastweek1) / week1) * 100) : 0
          .number #{week1}
          if diff1 > 0
            span.text-success &uarr; #{diff1.toFixed(1)}% vs last week
          else if diff1<0
            span.text-danger &darr; #{Math.abs(diff1).toFixed(1)}% vs last week
          else if diff1==0
            span.text-normal --
      section.dashboard-row
        .weekly-activity
          #activityChart
        .donut
          #chart
      section.bottom-widgets
        .events
          h3 Upcoming Events
          .event-card
            .date-box
              - const eventsarr = user.calender.eventstoday ? Object.values(user.calender.eventstoday) : []
              div #{eventsarr[0].date}
            .event-time
              | #{eventsarr[0].time}
            .event-details
              h4 #{eventsarr[0].name}
            span.status Today
        .aisummary 
          h3 AI Generated Summary 
          p #{user.aisummary}
script(src='https://cdn.jsdelivr.net/npm/apexcharts')
script(src='/static/dashboard.js')
