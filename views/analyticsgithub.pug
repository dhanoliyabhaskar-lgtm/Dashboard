doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Analytics
  link(rel='stylesheet' href='/static/analyticsgithub.css')
body(data-github=user.github)
.container
  aside.sidebar
    .logo
      img(src='/static/photos/dashboard logo.png' alt='')
      h2 Dashboard
    ul.menu
      li
        a(href='/dashboard')
          img(src='/static/photos/overview icon.png' alt='')
          span  Overview 
      li.active
        a(href='/analyticsgithub')
          img(src='/static/photos/analytics icon.png' alt='')
          span Analytics
      li
        a(href='/goals')
          img(src='/static/photos/goals icon.png' alt='')
          span Goals
      li
        a(href='/integration')
          img(src='/static/photos/integrations icon.png' alt='')
          span Integrations
      li
        a(href='/reports')
          img(src='/static/photos/reports icon.png' alt='')
          span Reports
      li
        a(href='/achievements')
          img(src='/static/photos/achievements icon.png' alt='')
          span Achievements
      li
        a(href='/settingsprofile')
          img(src='/static/photos/settings icon.png' alt='')
          span Settings
  .main-content
    // responsive header
    header.responsive-header
      .header-left
        button.menu-btn(onclick='roggle()')  &#x2630; 
        h2 Dashboard
      .header-right
        .notification-wrapper
            button(onclick='window.location.href="/notifications"')
              img.notifications-icon(src='/static/photos/notifications icon.jpeg' alt='notification')            
            span.badge 3
        button(onclick='window.location.href="/settingsprofile"')
          img.profile-logo(src='/static/photos/profile logo.png' alt='profile photo')
    .content(onclick='moggle()')
      // Header
      header.analytics-header
        div
          h2 Analytics
          p  Deep dive into your productivity 
      .tabs
        button(onclick="window.location.href='/analyticsgithub'"  class="active") Github
        button(onclick="window.location.href='/analyticscodeforces'") Codeforeces
        button(onclick="window.location.href='/analyticsspotify'") Spotify
        button(onclick="window.location.href='/analyticscalender'") Calendar
      section.analytics-cards
        .card
          .left &#x1F525;
          .right
            h4 Today&apos;s Commits
            - const rawCommits = user && user.github && user.github.commitsovertime ? user.github.commitsovertime : null
            - const commitsObj = Array.isArray(rawCommits) ? rawCommits[0] : rawCommits
            - const todayValue = commitsObj && commitsObj['0'] ? commitsObj['0'].value : 0
            - const yesterdayValue = commitsObj && commitsObj['1'] ? commitsObj['1'].value : 0
            - const diff = todayValue !== 0 ? (((todayValue - yesterdayValue) / todayValue) * 100) : 0
            div
              b #{todayValue}
            if diff > 0
              span.text-success &uarr; #{diff.toFixed(1)}% vs last day
            else if diff<0
              span.text-danger &darr; #{Math.abs(diff).toFixed(1)}% vs last day
            else if diff==0
              span.text-normal --
        .card
          .left &#x2708;&#xFE0F;
          .right
            h4 Total Public Repos
            div
              b #{user.github.totalrepo  || 0}
        .card
          .left &#x2B50;
          .right
            h4 Total Stars Earned
            div
              b #{user.github.taotalstar  || 0}
        .card
          .left &#x1F465;
          .right
            h4 Followers
            div
              b #{user.github.totalfollow  || 0}
      section.chart-section
        #commitChart
        #languageChart
      section.table-section
        p.scroll-hint &larr; Swipe horizontally to view all columns &rarr;
        h3  Repository Information Table 
        table
          thead
            tr
              th Repo Name
              th Created At
              th Stars
              th Watchers
              th Language
              th Forks
              th Project Size
          tbody
            -const repoarr = user.github.repolist ? Object.values(user.github.repolist) : []
            if repoarr.length > 0
              each repo in repoarr 
                tr 
                  td #{repo.name} 
                  td #{repo.createdat}
                  td #{repo.stars}
                  td #{repo.watchers}
                  td #{repo.language}
                  td #{repo.forks}
                  td #{repo.size}
                 
script(src='https://cdn.jsdelivr.net/npm/apexcharts')
script(src='/static/analyticsgithub.js')
