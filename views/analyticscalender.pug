doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Analytics
  link(rel='stylesheet' href='/static/analyticscalender.css')
body(data-user=user)
.container
  aside.sidebar
    .logo
      img(src='/static/photos/dashboard logo.png' alt='')
      h2 Dashboard
    ul.menu
      li
        a(href='/dashboard')
          img(src='/static/photos/overview icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/overview white icon.png' alt='' class="white-sidebar-icon")
          span  Overview 
      li.active
        a(href='/analyticsgithub')
          img(src='/static/photos/analytics icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/analytics white icon.png' alt='' class="white-sidebar-icon")
          span Analytics
      li
        a(href='/goals')
          img(src='/static/photos/goals icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/goals white icon.png' alt='' class="white-sidebar-icon")
          span Goals
      li
        a(href='/integration')
          img(src='/static/photos/integrations icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/integrations white icon.png' alt='' class="white-sidebar-icon")
          span Integrations
      li
        a(href='/reports')
          img(src='/static/photos/reports icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/reports white icon.png' alt='' class="white-sidebar-icon")
          span Reports
      li
        a(href='/achievements')
          img(src='/static/photos/achievements icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/achievements white icon.png' alt='' class="white-sidebar-icon")
          span Achievements
      li
        a(href='/settingsprofile')
          img(src='/static/photos/settings icon.png' alt='' class="black-sidebar-icon")
          img(src='/static/photos/settings white icon.png' alt='' class="white-sidebar-icon")
          span Settings
  .main-content
    // responsive header
    header.responsive-header
      .header-left
        button.menu-btn(onclick='roggle()')  &#x2630; 
        h2 Dashboard
      .header-right
        .notification-wrapper
            button(onclick='window.location.href="/notifications"')
              img.notifications-icon(src='/static/photos/notifications icon.jpeg' alt='notification')            
            span.badge 3
        button(onclick='window.location.href="/settingsprofile"')
          img.profile-logo(src='/static/photos/profile logo.png' alt='profile photo')
    .content(onclick='moggle()')
      // Header
      header.analytics-header
        div
          h2 Analytics
          p  Deep dive into your productivity 
      .tabs
        button(onclick="window.location.href='/analyticsgithub'") Github
        button(onclick="window.location.href='/analyticscodeforces'") Codeforeces
        button(onclick="window.location.href='/analyticsspotify'") Spotify
        button(onclick="window.location.href='/analyticscalender'"  class="active") Calendar
      section.analytics-cards
        .card
          .left &#x1F55D;
          .right
            h4 Total Events
            - const week1 = user.calender.totaleventsforweek || 0
            - const lastweek1 = user.calender.totaleventsforlastweek || 0
            - const diff1 = week1 !== 0 ? (((week1 - lastweek1) / week1) * 100) : 0
            div
              b #{week1}
            if diff1 > 0
              span.text-success &uarr; #{diff1.toFixed(1)}% vs last week
            else if diff1<0
              span.text-danger &darr; #{Math.abs(diff1).toFixed(1)}% vs last week
            else if diff1==0
              span.text-normal --
        .card
          .left &#x1F55D;
          .right
            h4 Scheduled Time
            - const week2 = user.calender.totalbusytimeforweek || 0
            - const lastweek2 = user.calender.totalbusytimeforlastweek || 0
            - const diff2 = week2 !== 0 ? (((week2 - lastweek2) / week2) * 100) : 0
            div
              b #{week2} hours
            if diff2 > 0
              span.text-success &uarr; #{diff2.toFixed(1)}% vs last week
            else if diff2<0
              span.text-danger &darr; #{Math.abs(diff2).toFixed(1)}% vs last week
            else if diff2==0
              span.text-normal --
        .card
          .left &#x1F55D;
          .right
            h4 Avg. Event Duration
            - const week3 = user.calender.avgeventtimeforweek || 0
            - const lastweek3 = user.calender.avgeventtimeforlastweek || 0
            - const diff3 = week3 !== 0 ? (((week3 - lastweek3) / week3) * 100) : 0
            div
              b #{week3} min
            if diff3 > 0
              span.text-success &uarr; #{diff3.toFixed(1)}% vs last week
            else if diff3<0
              span.text-danger &darr; #{Math.abs(diff3).toFixed(1)}% vs last week
            else if diff3==0
              span.text-normal --
        .card
          .left &#x1F55D;
          .right
            h4 Free Time
            - const week4 = user.calender.totalfreetimeforweek || 0
            - const lastweek4 = user.calender.totalfreetimeforlastweek || 0
            - const diff4 = week4 !== 0 ? (((week4 - lastweek4) / week4) * 100) : 0
            div
              b #{week4} hours
            if diff4 > 0
              span.text-success &uarr; #{diff4.toFixed(1)}% vs last week
            else if diff4<0
              span.text-danger &darr; #{Math.abs(diff4).toFixed(1)}% vs last week
            else if diff4==0
              span.text-normal -- 
      section.top-widgets
        #box-1
        #box-2.box
          .heading
            - const eventsarr = user.calender.eventstoday ? Object.values(user.calender.eventstoday) : []
            div
              h4 Today&apos;s Schedule
              if eventsarr.length>0
                p
                  b #{eventsarr[0].date}
              else 
                p 
                  b 
          -const schedulearr = user.calender.todayschedule ? Object.values(user.calender.todayschedule) : []
          if schedulearr.length > 0
            each schedule in schedulearr.slice(0,6)
              .schedule 
                .schedulename 
                  p #{schedule.start}
                  p | 
                  span #{schedule.name}
                .scheduleduration 
                  | #{schedule.time}
        #box-3.box
          .heading
            h4 Upcoming Events
          .events
            if eventsarr.length>0
              each event in eventsarr.slice(0,4)
                .event 
                  .left &bull;
                  .eventname 
                    h5 #{event.name}
                    p #{event.date} &bull; #{event.time}
      section.bottom-widgets
        - let busyarr = []
        - let rawData = user && user.calender && user.calender.mostbusydays
        - if (rawData) {
        -   let target = Array.isArray(rawData) && rawData[0] && !rawData[0].at ? rawData[0] : rawData
        -   busyarr = Object.keys(target).filter(k => !isNaN(k)).map(k => target[k])
        - }
      
        - let high = 0
        - let low = Infinity
        - let highdate = ''
        - let lowdate = ''
      
        - if (busyarr.length > 0) {
        -   busyarr.forEach(busy => {
        -     if (busy && busy.value !== undefined) {
        -       if (busy.value > high) {
        -         high = busy.value
        -         highdate = busy.at
        -       }
        -       if (busy.value < low) {
        -         low = busy.value
        -         lowdate = busy.at
        -       }
        -     }
        -   })
        - }
        #item-1
        #item-2
        #item-3.box
          .heading
            h4 Insights
          .item
            .left &#x1F3B5;
            .right
              if diff1 >=0
                p
                  b You scheduled #{diff1.toFixed(1)}% more events this week.
                p Great job staying productive!
              else 
                p 
                  b You scheduled #{Math.abs(diff2).toFixed(1)}% less events this week.
                p Improve your self !
          .item
            .left &#x2B50;
            .right
              p
                b #{highdate} is your busiest day.
              p You have #{high} hours of scheduled events.
          .item
            .left &#x1F525;
            .right
              p
                b Your avarage meeting duration is #{user.calender.avgeventtime[6]} min.
              p Ideal meeting length!
          .item
            .left &#x1F375;
            .right
              p
                b You have the most free time on #{lowdate}.
              p Enjoy your free time!
script(src='https://cdn.jsdelivr.net/npm/apexcharts')
script(src='/static/analyticscalender.js')
